{
  "name": "stockmarket-tv",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src && npm run test:installer",
    "android:sync": "npm run build && node scripts/sync-android.mjs",
    "tv:install": "node scripts/install-tv.mjs",
    "test:installer": "node scripts/install-tv.test.mjs",
    "theme:sync": "node scripts/sync-theme.mjs"
  },
  "dependencies": {
    "convex": "^1.42.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
